# ===== 警心护航 后端环境变量 =====
PORT=3000
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d
DB_PATH=data/app.db

# AI 运行模式：mock（默认，无 Key 即可跑通）| real（调用真实 API）
AI_MODE=mock

# 主线 AI（DeepSeek 官方 API，OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-v4-pro

# 阿里云千问 / 百炼（图片、语音、实时语音）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
QWEN_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus

# 初始管理员（首次启动且无 admin 角色时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
